# Template for local secrets. Copy to .env and fill in:   cp .env.example .env
# .env is gitignored and must NEVER be committed or pasted in chat.

# Figma personal access token (starts with "figd_") — create at https://www.figma.com/developers/api#access-tokens
FIGMA_PAT=

# Your brand's Figma file — the asset source of truth (the key from figma.com/design/<KEY>/...)
FIGMA_FILE_KEY=

# Optional, only for the skills that use them
ELEVENLABS_API_KEY=
